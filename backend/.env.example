YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
X_BEARER_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_PROVIDER=mock
ANALYSIS_MODEL_PROVIDER=gpt
BRIEF_MODEL_PROVIDER=claude
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# MetaScraper sub-app (all optional)
# Shared secret required to POST captures to /api/metascraper/capture. Leave
# blank in local dev to keep the endpoint open; set in prod and embed it in the
# generated hunt command (Console → ingest token field).
METASCRAPER_INGEST_TOKEN=
# Apps Script Web App /exec URL that writes processed rows to your Google Sheet
# (see backend/metascraper/sheet_appscript.gs). Unset = sheet sync is skipped.
METASCRAPER_SHEET_WEBHOOK_URL=
# Must match the SHEET_SECRET script property in the Apps Script.
METASCRAPER_SHEET_SECRET=
